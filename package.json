{
  "name": "unlock-deck-viewer",
  "version": "3.5.0",
  "description": "Tiny app to load and play an Unlock adventure deck",
  "author": "sophietk",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=20.x",
    "npm": ">=10.x"
  },
  "scripts": {
    "lint": "run-p lint:*",
    "lint:js": "standard",
    "start": "run-p serve:*",
    "serve:api": "nodemon api",
    "serve:app": "http-server app -p 4000 -P http://localhost:3000",
    "clean:generated-img": "rm -rf api/decks/*.jpg && rm -rf api/decks/*.png"
  },
  "bin": {
    "unlock-deck-viewer": "bin/index.js"
  },
  "files": [
    "api",
    "app",
    "bin",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sophietk/unlock-deck-viewer.git"
  },
  "keywords": [
    "unlock",
    "deck",
    "viewer",
    "escape",
    "game",
    "room",
    "adventure",
    "scenario",
    "load",
    "pdf"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sophietk/unlock-deck-viewer/issues"
  },
  "homepage": "https://github.com/sophietk/unlock-deck-viewer#readme",
  "dependencies": {
    "commander": "^15.0.0",
    "express": "^5.3.0",
    "get-port": "^7.2.0",
    "http-server": "^14.1.1",
    "jimp": "^1.6.1",
    "pdf-to-img": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "npm-run-all2": "^9.0.3",
    "standard": "^17.1.2"
  },
  "overrides": {
    "minimatch": "^10.2.6",
    "nodemon": {
      "chokidar": "5.0.0"
    },
    "pdf-to-img": {
      "tar": "^7.5.10"
    }
  },
  "standard": {
    "globals": [
      "Handlebars",
      "fetch",
      "localStorage"
    ]
  }
}
